{
  "name": "india-electoral-boundaries",
  "version": "0.1.0",
  "private": true,
  "description": "Open boundary data for Indian assembly constituencies and city wards, maintained by Whistling Citizen and contributors.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "import:backend": "node scripts/import-from-backend.mjs",
    "validate": "node scripts/validate.mjs",
    "validate:geometry": "node scripts/validate.mjs --geometry",
    "build": "node scripts/build.mjs",
    "build:bump": "node scripts/build.mjs --bump",
    "parity": "node scripts/parity-check.mjs",
    "publish:cdn:dry": "node scripts/publish-cdn.mjs --dry-run",
    "publish:cdn": "node scripts/publish-cdn.mjs",
    "sync:backend": "node scripts/sync-backend.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@turf/turf": "^7.2.0",
    "ajv": "^8.17.1",
    "dotenv": "^16.4.7"
  }
}
