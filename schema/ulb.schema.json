{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ulb.schema.json",
  "title": "Urban local body (city) metadata",
  "description": "data/wards/{state}/{city}/ulb.json",
  "type": "object",
  "required": ["cityCode", "name", "stateCode", "backendFile", "wardCount", "sources"],
  "additionalProperties": false,
  "properties": {
    "cityCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$",
      "description": "City code used by the Whistling Citizen backend, e.g. CHENNAI, BBMP"
    },
    "name": { "type": "string", "minLength": 1 },
    "corporation": { "type": "string", "minLength": 1 },
    "stateCode": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "backendFile": {
      "type": "string",
      "pattern": "^[a-z0-9-]+\\.wards\\.geojson$",
      "description": "File name the backend loads from src/wards/data/"
    },
    "wardCount": { "type": "integer", "minimum": 1 },
    "delimitation": { "type": "string" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
